# Copy to .env (git ignores it). Every variable is optional for a local `docker compose up`.
# For `npm run dev` in apps/web, put the same variables in apps/web/.env.local.

# PostgreSQL connection. Unset: the bundled database container is used.
# Hosted providers' URLs work as-is, e.g. postgres://avnadmin:...@host:port/defaultdb?sslmode=require
# sslmode=require encrypts without verifying the server; set DATABASE_CA_CERT (the
# provider's CA certificate, PEM text) to verify it.
DATABASE_URL=
DATABASE_CA_CERT=

# Secret for signing sessions: 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production. Docker generates and stores one if unset.
BETTER_AUTH_SECRET=

# Public address of the app (used in links and the SDK instructions).
APP_URL=http://localhost:3000

# Password-reset email through Resend (free tier). Unset: reset links are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=

# Paper metadata: a contact address for Crossref's polite pool, and an OpenAlex API key.
CROSSREF_MAILTO=
OPENALEX_API_KEY=

# Optional tuning. Defaults shown.
# Connections per server instance (keep low on free database plans).
DATABASE_POOL_MAX=
# Total artifact storage per project, in MB. Artifacts are stored in PostgreSQL.
ARTIFACT_PROJECT_QUOTA_MB=50
# SDK requests per token per minute, per server instance.
SDK_RATE_LIMIT_PER_MIN=600
