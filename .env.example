# Copy to .env (which git ignores) and fill in to use a hosted PostgreSQL.
# Leave DATABASE_URL unset to use the PostgreSQL container from docker-compose.yml.
# Provider URLs such as postgres://user:password@host:port/db?sslmode=require work as-is.
DATABASE_URL=

# Optional: an OpenAlex API key for DOI imports beyond the small free daily allowance.
OPENALEX_API_KEY=
